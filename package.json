{
  "name": "smart-parking-thesis",
  "private": true,
  "version": "0.1.0",
  "description": "Smart Parking Gate Barrier system with ANPR (YOLO + PaddleOCR), Arduino Uno R3 SG90, and Realtime Web.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "gate:run": "node scripts/gate.mjs run",
    "gate:preflight": "node scripts/gate.mjs preflight",
    "vision:run": "node scripts/gate.mjs run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:browser:install": "playwright install chromium",
    "lint:e2e": "eslint playwright.config.ts tests/e2e/**/*.ts",
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace apps/api",
    "db:generate": "npm run db:generate --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace apps/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module"
}
